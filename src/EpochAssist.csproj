<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>EpochAssist</AssemblyName>
    <RootNamespace>EpochAssist</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <ML>$(LE_ML)</ML>
    <Il2Cpp>$(ML)\Il2CppAssemblies</Il2Cpp>
    <!-- A fresh id per compile, shown in the menu and the log so a report names the exact build. -->
    <BuildId>$([System.Guid]::NewGuid().ToString("N").Substring(0, 6))</BuildId>
    <!-- Read from BuildInfo.Version in Core/Entry.cs. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Core\Entry.cs')), 'string Version = "([^"]+)"').Groups[1].Value)</Version>
  </PropertyGroup>

  <!-- Dev-only code lives in Dev/ (namespace EpochAssist.Dev). Release builds don't compile it, and release code names it
       only inside #if DEV; build.sh release fails a package that still contains any of it. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <DefineConstants>$(DefineConstants);DEV</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Compile Remove="Dev/**" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildId</_Parameter1>
      <_Parameter2>$(BuildId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemDefinitionGroup>
    <Reference Private="false" />
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="MelonLoader" HintPath="$(ML)\net6\MelonLoader.dll" />
    <Reference Include="0Harmony" HintPath="$(ML)\net6\0Harmony.dll" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(ML)\net6\Il2CppInterop.Runtime.dll" />
    <Reference Include="Il2CppInterop.Common" HintPath="$(ML)\net6\Il2CppInterop.Common.dll" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(Il2Cpp)\Il2Cppmscorlib.dll" />
    <Reference Include="Il2CppSystem" HintPath="$(Il2Cpp)\Il2CppSystem.dll" />
    <Reference Include="Il2CppLE" HintPath="$(Il2Cpp)\Il2CppLE.dll" />
    <Reference Include="Il2CppRewired_Core" HintPath="$(Il2Cpp)\Il2CppRewired_Core.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Il2Cpp)\UnityEngine.CoreModule.dll" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(Il2Cpp)\UnityEngine.IMGUIModule.dll" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(Il2Cpp)\UnityEngine.InputLegacyModule.dll" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(Il2Cpp)\UnityEngine.TextRenderingModule.dll" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(Il2Cpp)\UnityEngine.ImageConversionModule.dll" />
    <Reference Include="UnityEngine.ScreenCaptureModule" HintPath="$(Il2Cpp)\UnityEngine.ScreenCaptureModule.dll" />
    <Reference Include="UnityEngine.UI" HintPath="$(Il2Cpp)\UnityEngine.UI.dll" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(Il2Cpp)\UnityEngine.UIModule.dll" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(Il2Cpp)\UnityEngine.ParticleSystemModule.dll" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(Il2Cpp)\Unity.TextMeshPro.dll" />
    <Reference Include="Unity.Mathematics" HintPath="$(Il2Cpp)\Unity.Mathematics.dll" />
    <Reference Include="Unity.Postprocessing.Runtime" HintPath="$(Il2Cpp)\Unity.Postprocessing.Runtime.dll" />
  </ItemGroup>

  <!-- patchcheck (Dev/) decodes the game's native code with the Iced decoder MelonLoader already ships and loads. -->
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <Reference Include="Iced" HintPath="$(ML)\net6\Iced.dll" />
    <!-- The dev test prompt is opened through the game's ConfirmAsync, which returns a UniTask. -->
    <Reference Include="Il2CppUniTask" HintPath="$(Il2Cpp)\Il2CppUniTask.dll" />
  </ItemGroup>

  <!-- Release builds write dist/EpochAssist-v<version>.zip holding only Mods/EpochAssist.dll, so extracting it into the game
       folder installs it; the README, changelog and license live on GitHub and Nexus. -->
  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <RepoDir>$(MSBuildProjectDirectory)\..\</RepoDir>
      <StagingDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)package\</StagingDir>
      <DistDir>$(RepoDir)dist\</DistDir>
      <ReleaseZip>$(DistDir)$(AssemblyName)-v$(Version).zip</ReleaseZip>
    </PropertyGroup>
    <Error Condition="'$(Version)' == ''" Text="Could not read BuildInfo.Version from Core/Entry.cs." />
    <Delete Files="$(ReleaseZip)" />
    <RemoveDir Directories="$(StagingDir)" />
    <MakeDir Directories="$(StagingDir)Mods;$(DistDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StagingDir)Mods" />
    <ZipDirectory SourceDirectory="$(StagingDir)" DestinationFile="$(ReleaseZip)" Overwrite="true" />
    <Message Importance="high" Text="Release package: $(ReleaseZip)" />
  </Target>

</Project>
